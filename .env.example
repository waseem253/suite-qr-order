# --- Stripe (TEST mode) ---
# With these set, checkout is a real Stripe test session the client can
# put a test card into (4242 4242 4242 4242). Without them, the app uses
# a clearly-labeled simulated payment so the demo never breaks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Owner notifications ---
OWNER_EMAIL=owner@example-hotel.mt

# --- WhatsApp Business API (one number per category) ---
# Provider: meta | twilio | messagebird  (dry-run logs if unset)
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_FROM=
WA_NUMBER_FNB=+35600000001
WA_NUMBER_ADVENTURE=+35600000002
WA_NUMBER_TAXI=+35600000003
